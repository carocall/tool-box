{
  "name": "carocall-tool-box",
  "private": true,
  "version": "2.1.0",
  "type": "module",
  "description": "Carocall Tool Box —— 可视化编辑，导出论文风黑白架构图（ER / 用例 / 功能模块 / 时序），支持 drawio 多页导出",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "build:fast": "vite build",
    "release": "npm run build && node tools/release.mjs",
    "typecheck": "vue-tsc --noEmit",
    "check": "npm run typecheck && npm run build && node tools/selftest.mjs && node tools/verify.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vite-plugin-singlefile": "^2.1.0",
    "vue-tsc": "^2.2.0"
  }
}
